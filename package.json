    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@scure/bip39": "2.4.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.2",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-updater": "2.14.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "i18next": "26.5.4",
    "idb-keyval": "6.3.0",
    "minisearch": "7.2.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.1",
