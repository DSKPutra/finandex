{
  "name": "finandex",
  "version": "1.0.0",
  "private": true,
  "description": "Finandex — Wawasan Indeks Pasar Keuangan Global (Global Financial Market Indexing Insights). © 2026 Dea Saka Kurnia Putra. All rights reserved.",
  "author": "Dea Saka Kurnia Putra",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.server.json --noEmit && vite build",
    "build:ci": "npm run data:fetch && npm run data:verify && npm run data:extract && npm run data:build && npm run test:golden && npm run build",
    "preview": "vite preview",
    "data:fetch": "tsx scripts/data/fetch-inputs.ts",
    "data:verify": "tsx scripts/data/verify-inputs.ts",
    "data:extract": "tsx scripts/data/extract.ts",
    "data:build": "tsx scripts/data/build-all.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --project tools --coverage",
    "test:golden": "vitest run --project golden",
    "test:tools": "vitest run --project tools",
    "test:parity": "tsx scripts/data/parity.ts",
    "eval:chat:mock": "tsx scripts/eval/eval-chat.ts --mode mock",
    "eval:chat": "tsx scripts/eval/eval-chat.ts --mode live",
    "e2e": "playwright test",
    "a11y": "playwright test tests/a11y",
    "lighthouse": "lhci autorun",
    "size": "size-limit",
    "check:copyright": "tsx scripts/brand/check-copyright.ts",
    "check:licenses": "tsx scripts/brand/check-licenses.ts",
    "check:secrets": "tsx scripts/brand/check-secrets.ts",
    "check:contrast": "tsx scripts/brand/check-contrast.ts",
    "verify": "npm run lint && npm run typecheck && npm run check:copyright && npm run check:contrast && npm run check:licenses && npm run check:secrets && npm run test:coverage && npm run test:golden && npm run test:tools && npm run eval:chat:mock && npm run build && npm run size && npm run e2e",
    "cap:sync": "cap sync",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "assets:generate": "capacitor-assets generate --iconBackgroundColor '#0A0F0C' --splashBackgroundColor '#0A0F0C'",
    "prompts:build": "tsx scripts/chat/bundle-prompts.ts"
  },
  "size-limit": [
    {
      "name": "initial JS (gzip)",
      "path": "dist/assets/index-*.js",
      "limit": "250 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@capacitor/core": "^8.5.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@scure/bip39": "^2.4.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "echarts": "^6.1.0",
    "i18next": "^26.5.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "hyparquet": "^1.31.5",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yauzl": "^3.4.0"
  }
}
